# frontend — React frontend (Vite)
# Copy to .env and fill real values. NEVER commit .env or any secret.
# VITE_* variables are inlined into the browser bundle at build time.

# Base URL the frontend uses to reach the Node API (same-origin path or absolute URL).
# In dev the Vite proxy forwards /api → http://localhost:3000 (see vite.config.js).
# Production builds bake this value; default matches Fastify's /api/v1 + static SPA host.
VITE_API_BASE_URL=/api/v1
