{
  "name": "codex-sage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Root scripts for setup, install, and run of backend and frontend",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "install": "bash scripts/install.sh",
    "dev": "bash scripts/dev.sh",
    "build": "bash scripts/build.sh",
    "start": "bash scripts/start.sh",
    "test": "bash scripts/test.sh",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.js",
    "test:e2e:env": "node --test tests/e2e/helpers/validate-e2e-env.test.js",
    "playwright:install": "bash scripts/playwright-install-chromium.sh",
    "lint": "bash scripts/lint.sh",
    "clean": "bash scripts/clean.sh",
    "measure-llm-host": "node scripts/measure-llm-host.mjs",
    "eval:answer-quality": "node docs/evaluation/run-answer-quality.mjs",
    "prepare": "husky",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "dotenv": "^18.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.1"
  }
}
