# Stack (operator-started — Playwright does not start services)
# Prefer 127.0.0.1: Vite binds IPv4 in vite.config.js so Node fetch / Playwright resolve cleanly.
E2E_BASE_URL=http://127.0.0.1:5173
E2E_API_URL=http://127.0.0.1:3000

# Bootstrap admin (matches ADR 0011 / backend seed constants)
E2E_ADMIN_EMAIL=admin@localhost
E2E_ADMIN_PASSWORD=abc123

# Optional public repo override (default is sindresorhus/is-docker)
# E2E_PUBLIC_REPO_URL=https://github.com/sindresorhus/is-docker.git
# E2E_REPO_BRANCH=main

# Optional private-repo attach (tests skip when either is blank)
# E2E_PRIVATE_REPO_URL=
# E2E_GITHUB_TOKEN=

# Optional
# E2E_HEADLESS=1
# E2E_SKIP=1
