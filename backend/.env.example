# backend — Node API service
# Copy to .env and fill real values. NEVER commit .env or any secret.

# --- Server ---
API_HOST=0.0.0.0
API_PORT=3000
NODE_ENV=development
APP_RUNNING_PLATFORM=standalone   # container | standalone (default standalone)
LOG_LEVEL=info                    # debug | info | warning | error
NO_CONSOLE_LOG=false              # standalone only; ignored when APP_RUNNING_PLATFORM=container

# --- MongoDB (external replica set; database name is part of the URI) ---
MONGODB_URI=mongodb://127.0.0.1:27017/codex_sage?replicaSet=rs0

# --- Auth (JWT access-token signing; generate a unique 32+ byte value per environment) ---
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_TOKEN_SECRET=change-me-to-a-long-random-secret-value

# --- Workspace (absolute path to the encrypted volume root for materialized project trees) ---
# Must differ per machine/environment. Never point at a shared multi-tenant path without isolation.
WORKSPACE_ROOT=/var/lib/codex-sage/workspace

# --- Repository credentials (AES-256-GCM; 32-byte key, base64-encoded) ---
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
REPO_CREDENTIAL_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
REPO_CREDENTIAL_KEY_ID=k1
# Allow loopback/private hosts for local GitLab only. Leave false in production.
REPO_PROBE_ALLOW_PRIVATE_HOSTS=false
