# backend — Node API service
# Copy to .env and fill real values. NEVER commit .env or any secret.

# --- Server ---
API_HOST=0.0.0.0
API_PORT=3000
NODE_ENV=development
APP_RUNNING_PLATFORM=standalone   # container | standalone (default standalone)
LOG_LEVEL=info                    # debug | info | warning | error
NO_CONSOLE_LOG=false              # standalone only; ignored when APP_RUNNING_PLATFORM=container
